{
  "name": "school-management-system",
  "version": "0.1.0-rc.1",
  "description": "A web-based educational institution management system.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate --workspace @school-management-system/api",
    "predev:web": "node scripts/free-port.mjs 4200",
    "dev:web": "npm run dev --workspace @school-management-system/web",
    "stop:web": "node scripts/free-port.mjs 4200",
    "start:web": "npm run start --workspace @school-management-system/web",
    "prestart:api": "node scripts/free-port.mjs 4000",
    "start:api": "npm run start --workspace @school-management-system/api",
    "stop:api": "node scripts/free-port.mjs 4000",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace @school-management-system/web",
    "build:api": "npm run build --workspace @school-management-system/api",
    "typecheck": "npm run typecheck --workspace @school-management-system/api",
    "test:schemas": "npm run test:schemas --workspace @school-management-system/api",
    "test:tenant": "npm run test:tenant --workspace @school-management-system/api",
    "db:push": "npm run db:push --workspace @school-management-system/api",
    "db:validate": "npm run db:validate --workspace @school-management-system/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @school-management-system/api",
    "db:bootstrap": "npm run db:bootstrap --workspace @school-management-system/api",
    "db:seed:dev": "npm run db:seed:dev --workspace @school-management-system/api",
    "test": "npm run test --workspace @school-management-system/web",
    "lint": "npm run lint --workspace @school-management-system/web"
  },
  "prisma": {
    "seed": "npm run db:seed:dev"
  },
  "private": true,
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^21.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.14.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.13.0"
  }
}
