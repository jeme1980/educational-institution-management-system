NODE_ENV="production"
PORT="4000"
APP_URL="https://school.example.com"
CORS_ORIGINS="https://school.example.com"

# Local JWT used by the current API login flow. Use a secret of at least 32 characters.
AUTH_JWT_SECRET="replace-with-a-long-random-local-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# School runtime connection
# Runtime connection: use a LOGIN, NOSUPERUSER, NOBYPASSRLS role (for example school_app).
RLS_RUNTIME_DATABASE_URL="postgresql://school_app:replace-at-provisioning@host-pooler.region.example/database?sslmode=require"
RLS_RUNTIME_DB_ROLE="school_app"
RLS_RUNTIME_DB_PASSWORD="replace-at-provisioning"

# Migration/admin connection: owner or migration role only; never use this for API runtime.
MIGRATION_DATABASE_URL="postgresql://migration_user:replace-at-provisioning@host.region.aws.neon.tech/database?sslmode=require"
# Required public HTTPS page; never include a setup token. No localhost in production.
ACCOUNT_SETUP_URL_BASE="https://school.example.com/account/setup"
# Required platform API connection. Must use a restricted platform runtime role, never postgres/superuser/BYPASSRLS.
PLATFORM_DATABASE_URL="postgresql://platform_app:replace-at-provisioning@host.region.aws.neon.tech/database?sslmode=require"
PLATFORM_RUNTIME_DB_ROLE="platform_app"
PLATFORM_RUNTIME_DB_PASSWORD="replace-at-provisioning"

# Required by the static Web artifact when hosted with npm run start:web.
WEB_PORT="3000"
WEB_API_ORIGINS="https://school.example.com"

# Optional platform administrator provisioned only by the explicit `npm run db:bootstrap` command.
# Existing platform administrators are never assigned a new password by repeated bootstrap runs.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""
