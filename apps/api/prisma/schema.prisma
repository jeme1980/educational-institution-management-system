  academicYearId   String             @db.Uuid
  surveyId         String             @db.Uuid
  roundId          String             @db.Uuid
  segmentId        String             @db.Uuid
  participantCount Int?
  eligibleCount    Int?
  responseRate     Decimal?           @db.Decimal(5, 2)
  importBatchId    String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  institution      Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear       @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_participation_results_year_fkey")
  survey           Survey             @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_participation_results_survey_fkey")
  round            SurveyRound        @relation(fields: [institutionId, surveyId, roundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_participation_results_round_fkey")
  segment          SurveySegment      @relation(fields: [institutionId, surveyId, segmentId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_participation_results_segment_fkey")
  importBatch      SurveyImportBatch? @relation(fields: [institutionId, surveyId, roundId, importBatchId], references: [institutionId, surveyId, roundId, id], onDelete: Restrict, map: "survey_participation_results_batch_fkey")

  @@unique([roundId, segmentId])
  @@index([institutionId, surveyId, roundId])
