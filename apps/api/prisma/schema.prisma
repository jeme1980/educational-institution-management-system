  institutionId String         @db.Uuid
  nameAr        String
  nameHe        String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  examQuestions ExamQuestion[]

  @@index([institutionId, isActive, sortOrder])
  @@map("question_types")
}

model ExamType {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  nameAr        String
  nameHe        String?
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exams         Exam[]

  @@unique([institutionId, id])
  @@index([institutionId, isActive, sortOrder])
  @@map("exam_types")
}

model StudyGroup {
  id                String              @id @default(uuid()) @db.Uuid
  institutionId     String              @db.Uuid
  academicYearId    String              @db.Uuid
  classId           String?             @db.Uuid
  subjectId         String              @db.Uuid
  staffAssignmentId String?             @db.Uuid
  nameAr            String
  nameHe            String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  archivedAt        DateTime?
  createdBy         String?             @db.Uuid
  updatedBy         String?             @db.Uuid
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear      AcademicYear        @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict)
  classRoom         Class?              @relation(fields: [institutionId, academicYearId, classId], references: [institutionId, academicYearId, id], onDelete: Restrict)
  subject           Subject             @relation(fields: [institutionId, academicYearId, subjectId], references: [institutionId, academicYearId, id], onDelete: Restrict)
  staffAssignment   StaffAssignment?    @relation(fields: [institutionId, academicYearId, staffAssignmentId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "study_groups_institutionId_academicYearId_staffAssignmentId_fke")
  students          StudyGroupStudent[]
  examGroups        ExamStudyGroup[]
  interventions     Intervention[]

  @@unique([institutionId, id])
  @@index([institutionId, academicYearId, subjectId])
  @@index([classId])
  @@map("study_groups")
}

model StudyGroupStudent {
  id                  String            @id @default(uuid()) @db.Uuid
  institutionId       String            @db.Uuid
  studyGroupId        String            @db.Uuid
  studentEnrollmentId String            @db.Uuid
  createdAt           DateTime          @default(now())
  institution         Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studyGroup          StudyGroup        @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, studentEnrollmentId])
  @@index([institutionId, studyGroupId])
  @@index([institutionId, studentEnrollmentId])
  @@map("study_group_students")
}

model Exam {
  id                    String              @id @default(uuid()) @db.Uuid
  institutionId         String              @db.Uuid
  academicYearId        String              @db.Uuid
  academicPeriodId      String              @db.Uuid
  subjectId             String              @db.Uuid
  examTypeId            String              @db.Uuid
  titleAr               String
  titleHe               String?
  examDate              DateTime            @db.Date
  maxScore              Decimal             @db.Decimal(5, 2)
  weight                Decimal?            @db.Decimal(5, 2)
  isPublished           Boolean             @default(false)
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  archivedAt            DateTime?
  createdBy             String?             @db.Uuid
  updatedBy             String?             @db.Uuid
  institution           Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear        @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict)
  academicPeriod        AcademicPeriod      @relation(fields: [institutionId, academicYearId, academicPeriodId], references: [institutionId, academicYearId, id], onDelete: Restrict)
  subject               Subject             @relation(fields: [institutionId, academicYearId, subjectId], references: [institutionId, academicYearId, id], onDelete: Restrict)
  examType              ExamType            @relation(fields: [institutionId, examTypeId], references: [institutionId, id], onDelete: Restrict)
  examGroups            ExamStudyGroup[]
  examQuestions         ExamQuestion[]
  studentExamResults    StudentExamResult[]
  baselineInterventions Intervention[]      @relation("InterventionBaselineExam")

  @@unique([institutionId, id])
  @@index([institutionId, academicYearId, academicPeriodId])
  @@index([subjectId])
  @@index([examTypeId])
  @@map("exams")
}

model Intervention {
  id               String                @id @default(uuid()) @db.Uuid
  institutionId    String                @db.Uuid
  academicYearId   String                @db.Uuid
  subjectId        String                @db.Uuid
  studyGroupId     String                @db.Uuid
  baselineExamId   String                @db.Uuid
  title            String
  activity         String?               @db.Text
  plannedDuration  String?               @db.VarChar(120)
  startDate        DateTime              @db.Date
  endDate          DateTime?             @db.Date
  successCriterion Json?
  status           String                @default("planned") @db.VarChar(20)
  createdBy        String?               @db.Uuid
  updatedBy        String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  archivedAt       DateTime?
  institution      Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear          @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict)
  subject          Subject               @relation(fields: [institutionId, academicYearId, subjectId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "interventions_institutionId_subjectId_fkey")
  studyGroup       StudyGroup            @relation(fields: [institutionId, studyGroupId], references: [institutionId, id], onDelete: Restrict)
  baselineExam     Exam                  @relation("InterventionBaselineExam", fields: [institutionId, baselineExamId], references: [institutionId, id], onDelete: Restrict)
  students         InterventionStudent[]
  skills           InterventionSkill[]

  @@unique([institutionId, id])
  @@index([institutionId, academicYearId, subjectId, studyGroupId], map: "interventions_institutionId_academicYearId_subjectId_studyGroup")
  @@index([institutionId, baselineExamId])
  @@index([institutionId, status, archivedAt])
  @@map("interventions")
}

model InterventionStudent {
  id                  String            @id @default(uuid()) @db.Uuid
  institutionId       String            @db.Uuid
  interventionId      String            @db.Uuid
  studentEnrollmentId String            @db.Uuid
  createdAt           DateTime          @default(now())
  institution         Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  intervention        Intervention      @relation(fields: [institutionId, interventionId], references: [institutionId, id], onDelete: Cascade)
  studentEnrollment   StudentEnrollment @relation(fields: [institutionId, studentEnrollmentId], references: [institutionId, id], onDelete: Restrict)

  @@unique([interventionId, studentEnrollmentId])
  @@index([institutionId, interventionId])
  @@index([institutionId, studentEnrollmentId])
  @@map("intervention_students")
}

model InterventionSkill {
  id              String       @id @default(uuid()) @db.Uuid
  institutionId   String       @db.Uuid
  interventionId  String       @db.Uuid
  skillId         String       @db.Uuid
  baselineMastery Decimal?     @db.Decimal(5, 2)
  targetMastery   Decimal?     @db.Decimal(5, 2)
  createdAt       DateTime     @default(now())
  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  intervention    Intervention @relation(fields: [institutionId, interventionId], references: [institutionId, id], onDelete: Cascade)
  skill           Skill        @relation(fields: [institutionId, skillId], references: [institutionId, id], onDelete: Restrict)

  @@unique([interventionId, skillId])
  @@index([institutionId, interventionId])
  @@index([institutionId, skillId])
  @@map("intervention_skills")
}

model ExamStudyGroup {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  examId        String      @db.Uuid
  studyGroupId  String      @db.Uuid
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exam          Exam        @relation(fields: [institutionId, examId], references: [institutionId, id], onDelete: Cascade)
  studyGroup    StudyGroup  @relation(fields: [institutionId, studyGroupId], references: [institutionId, id], onDelete: Cascade)

  @@unique([examId, studyGroupId])
  @@index([institutionId, examId])
  @@index([institutionId, studyGroupId])
  @@map("exam_study_groups")
}

model ExamQuestion {
  id             String                 @id @default(uuid()) @db.Uuid
  institutionId  String                 @db.Uuid
  examId         String                 @db.Uuid
  questionTypeId String                 @db.Uuid
  topicId        String?                @db.Uuid
  skillId        String?                @db.Uuid
  questionNumber Int
  maxScore       Decimal                @db.Decimal(5, 2)
  contentAr      String?                @db.Text
  contentHe      String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  institution    Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exam           Exam                   @relation(fields: [institutionId, examId], references: [institutionId, id], onDelete: Cascade)
  questionType   QuestionType           @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  topic          Topic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  skill          Skill?                 @relation(fields: [skillId], references: [id], onDelete: SetNull)
  studentScores  StudentQuestionScore[]

  @@unique([examId, questionNumber])
  @@index([institutionId, examId])
  @@index([topicId])
  @@index([skillId])
  @@map("exam_questions")
}

model StudentQuestionScore {
  id             String       @id @default(uuid()) @db.Uuid
  institutionId  String       @db.Uuid
  examQuestionId String       @db.Uuid
  studentId      String       @db.Uuid
  score          Decimal      @db.Decimal(5, 2)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  student        Student      @relation("StudentQuestionScores", fields: [institutionId, studentId], references: [institutionId, id], onDelete: Restrict)

  @@unique([examQuestionId, studentId])
  @@index([institutionId, studentId])
  @@map("student_question_scores")
}

model StudentExamResult {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  examId        String      @db.Uuid
  studentId     String      @db.Uuid
  totalScore    Decimal     @db.Decimal(5, 2)
  isAbsence     Boolean     @default(false)
  absenceReason String?     @db.Text
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student     @relation("StudentExamResults", fields: [institutionId, studentId], references: [institutionId, id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([institutionId, studentId])
  @@map("student_exam_results")
}

/// Aggregate-only school survey definition. Respondent identities and individual
/// responses are intentionally out of scope for this data model.
model Survey {
  id                   String                      @id @default(uuid()) @db.Uuid
  institutionId        String                      @db.Uuid
  academicYearId       String                      @db.Uuid
  nameAr               String
  nameHe               String?
  descriptionAr        String?                     @db.Text
  descriptionHe        String?                     @db.Text
  audienceType         String?                     @db.VarChar(40)
  status               String                      @default("DRAFT") @db.VarChar(30)
  isActive             Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  archivedAt           DateTime?
  institution          Institution                 @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear                @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "surveys_institution_year_fkey")
  sections             SurveySection[]
  domains              SurveyDomain[]
  indicators           SurveyIndicator[]
  rounds               SurveyRound[]
  segments             SurveySegment[]
  importBatches        SurveyImportBatch[]
  indicatorResults     SurveyIndicatorResult[]
  domainResults        SurveyDomainResult[]
  domainComparisons    SurveyDomainComparison[]
  participationResults SurveyParticipationResult[]

  @@unique([institutionId, id])
  @@unique([institutionId, academicYearId, id])
  @@index([institutionId, academicYearId])
  @@index([institutionId, status, archivedAt])
  @@map("surveys")
}

model SurveySection {
  id               String                  @id @default(uuid()) @db.Uuid
  institutionId    String                  @db.Uuid
  surveyId         String                  @db.Uuid
  code             String                  @db.VarChar(80)
  nameAr           String
  nameHe           String?
  descriptionAr    String?                 @db.Text
  descriptionHe    String?                 @db.Text
  sortOrder        Int                     @default(0)
  isOptional       Boolean                 @default(false)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  institution      Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  survey           Survey                  @relation(fields: [institutionId, surveyId], references: [institutionId, id], onDelete: Restrict, map: "survey_sections_survey_fkey")
  domains          SurveyDomain[]
  indicatorResults SurveyIndicatorResult[]

  @@unique([institutionId, surveyId, code])
  @@unique([institutionId, surveyId, id])
  @@index([institutionId, surveyId, sortOrder])
  @@map("survey_sections")
}

model SurveyDomain {
  id                String                   @id @default(uuid()) @db.Uuid
  institutionId     String                   @db.Uuid
  surveyId          String                   @db.Uuid
  sectionId         String                   @db.Uuid
  code              String                   @db.VarChar(80)
  nameAr            String
  nameHe            String?
  descriptionAr     String?                  @db.Text
  descriptionHe     String?                  @db.Text
  sortOrder         Int                      @default(0)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  institution       Institution              @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  survey            Survey                   @relation(fields: [institutionId, surveyId], references: [institutionId, id], onDelete: Restrict, map: "survey_domains_survey_fkey")
  section           SurveySection            @relation(fields: [institutionId, surveyId, sectionId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domains_section_fkey")
  indicators        SurveyIndicator[]
  indicatorResults  SurveyIndicatorResult[]
  domainResults     SurveyDomainResult[]
  domainComparisons SurveyDomainComparison[]

  @@unique([institutionId, surveyId, code])
  @@unique([institutionId, surveyId, id])
  @@index([institutionId, surveyId, sectionId, sortOrder])
  @@map("survey_domains")
}

model SurveyIndicator {
  id                 String                  @id @default(uuid()) @db.Uuid
  institutionId      String                  @db.Uuid
  surveyId           String                  @db.Uuid
  domainId           String                  @db.Uuid
  code               String                  @db.VarChar(80)
  textAr             String                  @db.Text
  textHe             String?                 @db.Text
  descriptionAr      String?                 @db.Text
  descriptionHe      String?                 @db.Text
  sortOrder          Int                     @default(0)
  isActive           Boolean                 @default(true)
  reportingRuleCode  String?                 @db.VarChar(50)
  isReverseDirection Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  survey             Survey                  @relation(fields: [institutionId, surveyId], references: [institutionId, id], onDelete: Restrict, map: "survey_indicators_survey_fkey")
  domain             SurveyDomain            @relation(fields: [institutionId, surveyId, domainId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicators_domain_fkey")
  results            SurveyIndicatorResult[]

  @@unique([institutionId, surveyId, code])
  @@unique([institutionId, surveyId, id])
  @@index([institutionId, surveyId, domainId, sortOrder])
  @@map("survey_indicators")
}

model SurveyRound {
  id                   String                      @id @default(uuid()) @db.Uuid
  institutionId        String                      @db.Uuid
  academicYearId       String                      @db.Uuid
  surveyId             String                      @db.Uuid
  code                 String                      @db.VarChar(80)
  nameAr               String
  nameHe               String?
  sequenceNumber       Int
  startsAt             DateTime?                   @db.Date
  endsAt               DateTime?                   @db.Date
  measurementDate      DateTime?                   @db.Date
  status               String                      @default("DRAFT") @db.VarChar(30)
  closedAt             DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  institution          Institution                 @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear                @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_rounds_year_fkey")
  survey               Survey                      @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_rounds_survey_fkey")
  importBatches        SurveyImportBatch[]
  indicatorResults     SurveyIndicatorResult[]
  domainResults        SurveyDomainResult[]
  domainComparisons    SurveyDomainComparison[]    @relation("SurveyDomainComparisonRound")
  comparisonTargets    SurveyDomainComparison[]    @relation("SurveyDomainComparisonTargetRound")
  participationResults SurveyParticipationResult[]

  @@unique([institutionId, surveyId, code])
  @@unique([institutionId, surveyId, sequenceNumber])
  @@unique([institutionId, surveyId, id])
  @@index([institutionId, surveyId, sequenceNumber])
  @@map("survey_rounds")
}

model SurveySegment {
  id                   String                      @id @default(uuid()) @db.Uuid
  institutionId        String                      @db.Uuid
  surveyId             String                      @db.Uuid
  code                 String                      @db.VarChar(80)
  nameAr               String
  nameHe               String?
  segmentType          String?                     @db.VarChar(40)
  sortOrder            Int                         @default(0)
  isActive             Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  institution          Institution                 @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  survey               Survey                      @relation(fields: [institutionId, surveyId], references: [institutionId, id], onDelete: Restrict, map: "survey_segments_survey_fkey")
  indicatorResults     SurveyIndicatorResult[]
  domainResults        SurveyDomainResult[]
  domainComparisons    SurveyDomainComparison[]
  participationResults SurveyParticipationResult[]

  @@unique([institutionId, surveyId, code])
  @@unique([institutionId, surveyId, id])
  @@index([institutionId, surveyId, sortOrder])
  @@map("survey_segments")
}

model SurveyImportBatch {
  id                   String                      @id @default(uuid()) @db.Uuid
  institutionId        String                      @db.Uuid
  academicYearId       String                      @db.Uuid
  surveyId             String                      @db.Uuid
  roundId              String                      @db.Uuid
  originalFileName     String                      @db.VarChar(500)
  fileHash             String                      @db.VarChar(128)
  importedByUserId     String?                     @db.Uuid
  status               String                      @default("PENDING") @db.VarChar(30)
  rowCount             Int?
  validRowCount        Int?
  invalidRowCount      Int?
  importedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  institution          Institution                 @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear         AcademicYear                @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_import_batches_year_fkey")
  survey               Survey                      @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_import_batches_survey_fkey")
  round                SurveyRound                 @relation(fields: [institutionId, surveyId, roundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_import_batches_round_fkey")
  importedByUser       User?                       @relation(fields: [importedByUserId], references: [id], onDelete: SetNull, map: "survey_import_batches_user_fkey")
  indicatorResults     SurveyIndicatorResult[]
  domainResults        SurveyDomainResult[]
  participationResults SurveyParticipationResult[]

  @@unique([institutionId, surveyId, roundId, fileHash], map: "survey_import_batches_institutionId_surveyId_roundId_fileHash_k")
  @@unique([institutionId, id])
  @@unique([institutionId, surveyId, roundId, id])
  @@index([institutionId, surveyId, roundId, createdAt], map: "survey_import_batches_institutionId_surveyId_roundId_createdAt_")
  @@index([importedByUserId])
  @@map("survey_import_batches")
}

model SurveyIndicatorResult {
  id                 String             @id @default(uuid()) @db.Uuid
  institutionId      String             @db.Uuid
  academicYearId     String             @db.Uuid
  surveyId           String             @db.Uuid
  roundId            String             @db.Uuid
  sectionId          String             @db.Uuid
  domainId           String             @db.Uuid
  indicatorId        String             @db.Uuid
  segmentId          String             @db.Uuid
  importBatchId      String?            @db.Uuid
  reportedPercentage Decimal?           @db.Decimal(5, 2)
  respondentCount    Int?
  earnedTotal        Decimal?           @db.Decimal(14, 4)
  possibleTotal      Decimal?           @db.Decimal(14, 4)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear       @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_indicator_results_year_fkey")
  survey             Survey             @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_indicator_results_survey_fkey")
  round              SurveyRound        @relation(fields: [institutionId, surveyId, roundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicator_results_round_fkey")
  section            SurveySection      @relation(fields: [institutionId, surveyId, sectionId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicator_results_section_fkey")
  domain             SurveyDomain       @relation(fields: [institutionId, surveyId, domainId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicator_results_domain_fkey")
  indicator          SurveyIndicator    @relation(fields: [institutionId, surveyId, indicatorId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicator_results_indicator_fkey")
  segment            SurveySegment      @relation(fields: [institutionId, surveyId, segmentId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_indicator_results_segment_fkey")
  importBatch        SurveyImportBatch? @relation(fields: [institutionId, surveyId, roundId, importBatchId], references: [institutionId, surveyId, roundId, id], onDelete: Restrict, map: "survey_indicator_results_batch_fkey")

  @@unique([roundId, indicatorId, segmentId])
  @@index([institutionId, surveyId, roundId])
  @@index([roundId, domainId])
  @@index([roundId, indicatorId])
  @@index([roundId, segmentId])
  @@map("survey_indicator_results")
}

model SurveyDomainResult {
  id              String             @id @default(uuid()) @db.Uuid
  institutionId   String             @db.Uuid
  academicYearId  String             @db.Uuid
  surveyId        String             @db.Uuid
  roundId         String             @db.Uuid
  domainId        String             @db.Uuid
  segmentId       String             @db.Uuid
  importBatchId   String?            @db.Uuid
  scorePercentage Decimal?           @db.Decimal(5, 2)
  respondentCount Int?
  isComparable    Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  institution     Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear    AcademicYear       @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_domain_results_year_fkey")
  survey          Survey             @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_domain_results_survey_fkey")
  round           SurveyRound        @relation(fields: [institutionId, surveyId, roundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_results_round_fkey")
  domain          SurveyDomain       @relation(fields: [institutionId, surveyId, domainId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_results_domain_fkey")
  segment         SurveySegment      @relation(fields: [institutionId, surveyId, segmentId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_results_segment_fkey")
  importBatch     SurveyImportBatch? @relation(fields: [institutionId, surveyId, roundId, importBatchId], references: [institutionId, surveyId, roundId, id], onDelete: Restrict, map: "survey_domain_results_batch_fkey")

  @@unique([roundId, domainId, segmentId])
  @@index([institutionId, surveyId, roundId])
  @@map("survey_domain_results")
}

model SurveyDomainComparison {
  id                String        @id @default(uuid()) @db.Uuid
  institutionId     String        @db.Uuid
  academicYearId    String        @db.Uuid
  surveyId          String        @db.Uuid
  roundId           String        @db.Uuid
  domainId          String        @db.Uuid
  segmentId         String        @db.Uuid
  comparisonType    String        @db.VarChar(50)
  comparisonCode    String?       @db.VarChar(50)
  comparisonValue   Decimal?      @db.Decimal(5, 2)
  comparisonRoundId String?       @db.Uuid
  noteAr            String?       @db.Text
  noteHe            String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  institution       Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear      AcademicYear  @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict, map: "survey_domain_comparisons_year_fkey")
  survey            Survey        @relation(fields: [institutionId, academicYearId, surveyId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "survey_domain_comparisons_survey_fkey")
  round             SurveyRound   @relation("SurveyDomainComparisonRound", fields: [institutionId, surveyId, roundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_comparisons_round_fkey")
  domain            SurveyDomain  @relation(fields: [institutionId, surveyId, domainId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_comparisons_domain_fkey")
  segment           SurveySegment @relation(fields: [institutionId, surveyId, segmentId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_comparisons_segment_fkey")
  comparisonRound   SurveyRound?  @relation("SurveyDomainComparisonTargetRound", fields: [institutionId, surveyId, comparisonRoundId], references: [institutionId, surveyId, id], onDelete: Restrict, map: "survey_domain_comparisons_target_round_fkey")

  @@unique([roundId, domainId, segmentId, comparisonType], map: "survey_domain_comparisons_roundId_domainId_segmentId_comparison")
  @@index([institutionId, surveyId, roundId])
  @@index([institutionId, surveyId, comparisonRoundId], map: "survey_domain_comparisons_institutionId_surveyId_comparisonRoun")
  @@map("survey_domain_comparisons")
}

model SurveyParticipationResult {
