datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// WARNING: Transitional aggregate used strictly for legacy JSON data migration.
/// TARGET DEPRECATION DATE: 2026-12-31 (v2.0 Release).
/// Do NOT introduce new business logic or entity attributes to this blob.
/// TODO: Execute migration script to parse `data` into dedicated tables and drop `AppState`.
model AppState {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @unique @db.Uuid
  data          Json
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("app_state")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

/// Global SaaS plan metadata. Plans are managed by the platform domain and
/// intentionally do not carry an institutionId.
model Plan {
  id            String                    @id @default(uuid()) @db.Uuid
  code          String                    @unique @db.VarChar(50)
  nameAr        String                    @db.VarChar(100)
  nameHe        String?                   @db.VarChar(100)
  descriptionAr String?                   @db.VarChar(500)
  descriptionHe String?                   @db.VarChar(500)
  maxStudents   Int?
  maxStaff      Int?
  maxUsers      Int?
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  subscriptions InstitutionSubscription[]

  @@index([isActive, code])
  @@map("plans")
}

model InstitutionSubscription {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String             @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus
  startsAt      DateTime
  endsAt        DateTime?
  trialEndsAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  plan          Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([institutionId, status, startsAt])
  @@index([planId, status])
  @@map("institution_subscriptions")
}

model Region {
  id           String        @id @default(uuid()) @db.Uuid
  nameAr       String
  nameHe       String?
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  institutions Institution[]
  towns        Town[]

  @@unique([nameAr])
  @@index([isActive, sortOrder])
  @@map("regions")
}

model Town {
  id           String        @id @default(uuid()) @db.Uuid
  nameAr       String
  nameHe       String?
  regionId     String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  institutions Institution[]
  students     Student[]

  @@unique([regionId, nameAr])
  @@index([regionId])
  @@map("towns")
}

model InstitutionStatus {
  id           String        @id @default(uuid()) @db.Uuid
  schoolCode   String?       @unique @db.VarChar(50)
  nameAr       String
  nameHe       String?
  isActive     Boolean       @default(true)
  isSystem     Boolean       @default(false)
  allowsLogin  Boolean       @default(true)
  allowsWrites Boolean       @default(true)
  isBillable   Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  institutions Institution[]

  @@index([isActive, sortOrder])
  @@map("institution_statuses")
}

model Language {
  id           String        @id @default(uuid()) @db.Uuid
  nameAr       String
  nameHe       String?
  nativeName   String
  direction    String        @default("rtl") @db.VarChar(3)
  isActive     Boolean       @default(true)
  isSystem     Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  institutions Institution[]

  @@index([isActive, sortOrder])
  @@map("languages")
}

model EducationType {
  id           String        @id @default(uuid()) @db.Uuid
  nameAr       String
  nameHe       String?
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  isSystem     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  institutions Institution[]

  @@index([isActive, sortOrder])
  @@map("education_types")
}

model EducationStage {
  id                     String                             @id @default(uuid()) @db.Uuid
  nameAr                 String
  nameHe                 String?
  sortOrder              Int                                @default(0)
  isActive               Boolean                            @default(true)
  isSystem               Boolean                            @default(false)
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  classes                Class[]
  rolloverTargetMappings AcademicYearRolloverClassMapping[]

  @@index([isActive, sortOrder])
  @@map("education_stages")
}

model GradeLevel {
  id                     String                             @id @default(uuid()) @db.Uuid
  codeNumber             Int                                @unique
  nameAr                 String                             @db.VarChar(50)
  nameHe                 String?                            @db.VarChar(10)
  sortOrder              Int                                @default(0)
  isActive               Boolean                            @default(true)
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  classes                Class[]
  topics                 Topic[]
  skills                 Skill[]
  rolloverTargetMappings AcademicYearRolloverClassMapping[]

  @@index([isActive, sortOrder])
  @@map("grade_levels")
}

model ClassType {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String
  nameHe    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]

  @@index([isActive, sortOrder])
  @@map("class_types")
}

model CompositionType {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String
  nameHe    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]

  @@index([isActive, sortOrder])
  @@map("composition_types")
}

model Institution {
  id                         String                             @id @default(uuid()) @db.Uuid
  schoolCode                 String                             @unique @db.VarChar(20)
  slug                       String                             @unique @db.VarChar(80)
  nameAr                     String
  nameHe                     String?
  phoneNumber                String?                            @db.VarChar(50)
  email                      String?                            @db.VarChar(250)
  typeId                     String                             @db.Uuid
  regionId                   String                             @db.Uuid
  townId                     String?                            @db.Uuid
  statusId                   String                             @db.Uuid
  defaultLanguageId          String                             @db.Uuid
  logoUrl                    String?
  brandingSettings           Json?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  archivedAt                 DateTime?
  createdBy                  String?                            @db.Uuid
  updatedBy                  String?                            @db.Uuid
  type                       EducationType                      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  region                     Region                             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  town                       Town?                              @relation(fields: [townId], references: [id], onDelete: SetNull)
  status                     InstitutionStatus                  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  defaultLanguage            Language                           @relation(fields: [defaultLanguageId], references: [id], onDelete: Restrict)
  academicYears              AcademicYear[]
  academicPeriods            AcademicPeriod[]
  students                   Student[]
  staffMembers               StaffMember[]
  staffDevelopments          StaffDevelopment[]
  specializations            Specialization[]
  jobRoles                   JobRole[]
  staffAssignments           StaffAssignment[]
  staffAssignmentSubjects    StaffAssignmentSubject[]
  institutionUsers           InstitutionUser[]
  roles                      Role[]
  rolePermissions            RolePermission[]
  institutionUserRoles       InstitutionUserRole[]
  classes                    Class[]
  studyGroups                StudyGroup[]
  groupStudents              StudyGroupStudent[]
  exams                      Exam[]
  subjects                   Subject[]
  topics                     Topic[]
  skills                     Skill[]
  examGroups                 ExamStudyGroup[]
  examQuestions              ExamQuestion[]
  studentScores              StudentQuestionScore[]
  studentExamResults         StudentExamResult[]
  examTypes                  ExamType[]
  questionTypes              QuestionType[]
  appState                   AppState?
  guardians                  Guardian[]
  studentEnrollments         StudentEnrollment[]
  attendances                Attendance[]
  studentGuardians           StudentGuardian[]
  studentMedicalProfiles     StudentMedicalProfile[]
  institutionProfiles        InstitutionProfile[]
  auditLogs                  AuditLog[]
  subscriptions              InstitutionSubscription[]
  interventions              Intervention[]
  interventionStudents       InterventionStudent[]
  interventionSkills         InterventionSkill[]
  annualSpecializations      AcademicYearSpecialization[]
  rollovers                  AcademicYearRollover[]
  rolloverEntityMaps         AcademicYearRolloverEntityMap[]
  rolloverDecisions          StudentRolloverDecision[]
  rolloverClassMappings      AcademicYearRolloverClassMapping[]
  surveys                    Survey[]
  surveySections             SurveySection[]
  surveyDomains              SurveyDomain[]
  surveyIndicators           SurveyIndicator[]
  surveyRounds               SurveyRound[]
  surveySegments             SurveySegment[]
  surveyImportBatches        SurveyImportBatch[]
  surveyIndicatorResults     SurveyIndicatorResult[]
  surveyDomainResults        SurveyDomainResult[]
  surveyDomainComparisons    SurveyDomainComparison[]
  surveyParticipationResults SurveyParticipationResult[]

  @@index([statusId])
  @@index([regionId])
  @@index([townId])
  @@map("institutions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String   @db.VarChar(40)
  entityType    String   @db.VarChar(80)
  entityId      String?  @db.Uuid
  metadata      Json?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId, createdAt])
  @@index([institutionId, entityType, entityId])
  @@index([institutionId, action, createdAt])
  @@map("audit_logs")
}

model AcademicYear {
  id                         String                       @id @default(uuid()) @db.Uuid
  institutionId              String                       @db.Uuid
  yearLabel                  String
  startDate                  DateTime
  endDate                    DateTime
  isCurrent                  Boolean                      @default(false)
  isClosed                   Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  archivedAt                 DateTime?
  createdBy                  String?                      @db.Uuid
  updatedBy                  String?                      @db.Uuid
  institution                Institution                  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  periods                    AcademicPeriod[]
  classes                    Class[]
  subjects                   Subject[]
  topics                     Topic[]
  skills                     Skill[]
  enrollments                StudentEnrollment[]
  staffAssignments           StaffAssignment[]
  studyGroups                StudyGroup[]
  exams                      Exam[]
  institutionProfiles        InstitutionProfile[]
  interventions              Intervention[]
  annualSpecializations      AcademicYearSpecialization[]
  rolloversAsSource          AcademicYearRollover[]       @relation("RolloverSourceYear")
  rolloversAsTarget          AcademicYearRollover[]       @relation("RolloverTargetYear")
  rolloverTargetDecisions    StudentRolloverDecision[]
  surveys                    Survey[]
  surveyRounds               SurveyRound[]
  surveyImportBatches        SurveyImportBatch[]
  surveyIndicatorResults     SurveyIndicatorResult[]
  surveyDomainResults        SurveyDomainResult[]
  surveyDomainComparisons    SurveyDomainComparison[]
  surveyParticipationResults SurveyParticipationResult[]

  @@unique([institutionId, yearLabel])
  @@unique([institutionId, id])
  @@index([institutionId, isCurrent])
  @@map("academic_years")
}

model InstitutionProfile {
  id                     String  @id @default(uuid()) @db.Uuid
  institutionId          String  @db.Uuid
  academicYearId         String  @db.Uuid
  principalStaffMemberId String? @db.Uuid

  careLevel      Decimal? @db.Decimal(4, 2)
  schoolVisionAr String?  @db.Text
  schoolVisionHe String?  @db.Text

  inspectorNameAr String? @db.VarChar(50)
  inspectorNameHe String? @db.VarChar(50)

  localAuthorityAr String? @db.VarChar(50)
  localAuthorityHe String? @db.VarChar(50)

  educationDepartmentHeadAr String? @db.VarChar(50)
  educationDepartmentHeadHe String? @db.VarChar(50)

  escortLevel Int?

  totalStudentsCache Int? @default(0)
  totalClassesCache  Int? @default(0)
  totalTeachersCache Int? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  principal    StaffMember? @relation("InstitutionProfilePrincipal", fields: [principalStaffMemberId], references: [id], onDelete: SetNull)

  @@unique([institutionId, academicYearId])
  @@index([institutionId])
  @@index([academicYearId])
  @@map("institution_profiles")
}

model AcademicPeriod {
  id             String       @id @default(uuid()) @db.Uuid
  institutionId  String       @db.Uuid
  academicYearId String       @db.Uuid
  nameAr         String
  nameHe         String?
  startDate      DateTime
  endDate        DateTime
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  exams          Exam[]

  @@unique([institutionId, academicYearId, id])
  @@index([institutionId, academicYearId, isActive])
  @@map("academic_periods")
}

model AcademicYearSpecialization {
  id               String         @id @default(uuid()) @db.Uuid
  institutionId    String         @db.Uuid
  academicYearId   String         @db.Uuid
  specializationId String         @db.Uuid
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear   @relation(fields: [institutionId, academicYearId], references: [institutionId, id], onDelete: Restrict)
  specialization   Specialization @relation(fields: [institutionId, specializationId], references: [institutionId, id], onDelete: Restrict, map: "academic_year_specializations_institutionId_specializationId_fk")

  @@unique([institutionId, academicYearId, specializationId], map: "academic_year_specializations_institutionId_academicYearId_spec")
  @@unique([institutionId, id])
  @@index([institutionId, academicYearId, isActive], map: "academic_year_specializations_institutionId_academicYearId_isAc")
  @@index([institutionId, specializationId], map: "academic_year_specializations_institutionId_specializationId_id")
  @@map("academic_year_specializations")
}

model AcademicYearRollover {
  id                   String                             @id @default(uuid()) @db.Uuid
  institutionId        String                             @db.Uuid
  sourceAcademicYearId String                             @db.Uuid
  targetAcademicYearId String                             @db.Uuid
  status               String                             @default("DRAFT") @db.VarChar(20)
  createdByUserId      String?                            @db.Uuid
  startedAt            DateTime?
  completedAt          DateTime?
  summary              Json?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  institution          Institution                        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sourceAcademicYear   AcademicYear                       @relation("RolloverSourceYear", fields: [institutionId, sourceAcademicYearId], references: [institutionId, id], onDelete: Restrict)
  targetAcademicYear   AcademicYear                       @relation("RolloverTargetYear", fields: [institutionId, targetAcademicYearId], references: [institutionId, id], onDelete: Restrict)
  entityMaps           AcademicYearRolloverEntityMap[]
  classMappings        AcademicYearRolloverClassMapping[]
  studentDecisions     StudentRolloverDecision[]

  @@unique([institutionId, id])
  @@index([institutionId, status])
  @@index([institutionId, sourceAcademicYearId])
  @@index([institutionId, targetAcademicYearId])
  @@map("academic_year_rollovers")
}

model AcademicYearRolloverClassMapping {
  id                   String                    @id @default(uuid()) @db.Uuid
  institutionId        String                    @db.Uuid
  rolloverId           String                    @db.Uuid
  sourceClassId        String                    @db.Uuid
  action               String                    @default("SKIP") @db.VarChar(20)
  validationStatus     String                    @default("UNRESOLVED") @db.VarChar(20)
  targetStageId        String?                   @db.Uuid
  targetGradeLevelId   String?                   @db.Uuid
  targetClassId        String?                   @db.Uuid
  targetParallelNumber Int?
  targetNameAr         String?
  targetNameHe         String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  institution          Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  rollover             AcademicYearRollover      @relation(fields: [institutionId, rolloverId], references: [institutionId, id], onDelete: Cascade, map: "academic_year_rollover_class_mappings_rollover_fkey")
  sourceClass          Class                     @relation("RolloverSourceClassMapping", fields: [institutionId, sourceClassId], references: [institutionId, id], onDelete: Restrict, map: "academic_year_rollover_class_mappings_source_class_fkey")
  targetClass          Class?                    @relation("RolloverTargetClassMapping", fields: [institutionId, targetClassId], references: [institutionId, id], onDelete: Restrict, map: "academic_year_rollover_class_mappings_target_class_fkey")
  targetStage          EducationStage?           @relation(fields: [targetStageId], references: [id], onDelete: Restrict, map: "academic_year_rollover_class_mappings_stage_fkey")
  targetGradeLevel     GradeLevel?               @relation(fields: [targetGradeLevelId], references: [id], onDelete: Restrict, map: "academic_year_rollover_class_mappings_grade_fkey")
  studentDecisions     StudentRolloverDecision[]

  @@unique([rolloverId, sourceClassId], map: "academic_year_rollover_class_mappings_rolloverId_sourceClassId_")
  @@unique([institutionId, id])
  @@index([institutionId, rolloverId, validationStatus], map: "academic_year_rollover_class_mappings_institutionId_rolloverId_")
  @@index([institutionId, sourceClassId], map: "academic_year_rollover_class_mappings_institutionId_sourceClass")
  @@map("academic_year_rollover_class_mappings")
}

model AcademicYearRolloverEntityMap {
  id             String               @id @default(uuid()) @db.Uuid
  institutionId  String               @db.Uuid
  rolloverId     String               @db.Uuid
  entityType     String               @db.VarChar(32)
  sourceEntityId String               @db.Uuid
  targetEntityId String               @db.Uuid
  createdAt      DateTime             @default(now())
  institution    Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  rollover       AcademicYearRollover @relation(fields: [institutionId, rolloverId], references: [institutionId, id], onDelete: Cascade, map: "academic_year_rollover_entity_maps_institutionId_rolloverId_fke")

  @@unique([rolloverId, entityType, sourceEntityId], map: "academic_year_rollover_entity_maps_rolloverId_entityType_source")
  @@unique([institutionId, id])
  @@index([institutionId, rolloverId, entityType], map: "academic_year_rollover_entity_maps_institutionId_rolloverId_ent")
  @@index([institutionId, entityType, sourceEntityId], map: "academic_year_rollover_entity_maps_institutionId_entityType_sou")
  @@map("academic_year_rollover_entity_maps")
}

model StudentRolloverDecision {
  id                   String                            @id @default(uuid()) @db.Uuid
  institutionId        String                            @db.Uuid
  rolloverId           String                            @db.Uuid
  studentId            String                            @db.Uuid
  sourceEnrollmentId   String                            @db.Uuid
  action               String?                           @db.VarChar(20)
  targetGradeLevelId   String?                           @db.Uuid
  targetAcademicYearId String?                           @db.Uuid
  targetClassId        String?                           @db.Uuid
  targetEnrollmentId   String?                           @db.Uuid
  targetClassMappingId String?                           @db.Uuid
  validationStatus     String                            @default("UNRESOLVED") @db.VarChar(20)
  warnings             Json?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  institution          Institution                       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  rollover             AcademicYearRollover              @relation(fields: [institutionId, rolloverId], references: [institutionId, id], onDelete: Cascade)
  student              Student                           @relation(fields: [institutionId, studentId], references: [institutionId, id], onDelete: Restrict)
  sourceEnrollment     StudentEnrollment                 @relation("RolloverSourceEnrollment", fields: [institutionId, sourceEnrollmentId], references: [institutionId, id], onDelete: Restrict, map: "student_rollover_decisions_institutionId_sourceEnrollmentId_fke")
  targetAcademicYear   AcademicYear?                     @relation(fields: [institutionId, targetAcademicYearId], references: [institutionId, id], onDelete: Restrict, map: "student_rollover_decisions_target_year_fkey")
  targetClass          Class?                            @relation(fields: [institutionId, targetAcademicYearId, targetClassId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "student_rollover_decisions_target_class_fkey")
  targetEnrollment     StudentEnrollment?                @relation("RolloverTargetEnrollment", fields: [institutionId, targetAcademicYearId, targetEnrollmentId], references: [institutionId, academicYearId, id], onDelete: Restrict, map: "student_rollover_decisions_target_enrollment_fkey")
  targetClassMapping   AcademicYearRolloverClassMapping? @relation(fields: [institutionId, targetClassMappingId], references: [institutionId, id], onDelete: Restrict, map: "student_rollover_decisions_class_mapping_fkey")

  @@unique([rolloverId, studentId])
  @@unique([institutionId, id])
  @@index([institutionId, rolloverId, validationStatus], map: "student_rollover_decisions_institutionId_rolloverId_validationS")
  @@index([institutionId, studentId])
  @@index([institutionId, sourceEnrollmentId])
  @@index([institutionId, targetClassMappingId], map: "student_rollover_decisions_institutionId_targetClassMappingId_i")
  @@map("student_rollover_decisions")
}

model Gender {
  id            String        @id @default(uuid()) @db.Uuid
  genderCode    String        @unique @db.VarChar(1)
  nameAr        String
  nameHe        String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  versionNumber Int           @default(1)
  students      Student[]
  staffMembers  StaffMember[]

  @@index([isActive, sortOrder])
  @@map("genders")
}

model StudentStatus {
  id            String    @id @default(uuid()) @db.Uuid
  nameAr        String
  nameHe        String?
  isFinalStatus Boolean   @default(false)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  versionNumber Int       @default(1)
  students      Student[]

  @@index([isActive, sortOrder])
  @@map("student_statuses")
}

model Student {
  id              String  @id @default(uuid()) @db.Uuid
  institutionId   String  @db.Uuid
  genderId        String? @db.Uuid
  studentStatusId String  @db.Uuid
  townId          String? @db.Uuid

  nationalId String @unique @db.VarChar(10)

  firstNameAr String  @db.VarChar(150)
  lastNameAr  String  @db.VarChar(150)
  firstNameHe String? @db.VarChar(150)
  lastNameHe  String? @db.VarChar(150)

  birthDate DateTime? @db.Date
  photoUrl  String?   @db.VarChar(1000)

  email       String? @db.VarChar(250)
  phoneNumber String? @db.VarChar(50)

  addressAr String? @db.Text
  addressHe String? @db.Text

  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versionNumber Int      @default(1)

  institution           Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  gender                Gender?                   @relation(fields: [genderId], references: [id], onDelete: Restrict)
  studentStatus         StudentStatus             @relation(fields: [studentStatusId], references: [id], onDelete: Restrict)
  town                  Town?                     @relation(fields: [townId], references: [id], onDelete: SetNull)
  studentMedicalProfile StudentMedicalProfile?
  studentGuardians      StudentGuardian[]
  studentEnrollments    StudentEnrollment[]
  rolloverDecisions     StudentRolloverDecision[]
  examResults           StudentExamResult[]       @relation("StudentExamResults")
  questionScores        StudentQuestionScore[]    @relation("StudentQuestionScores")

  @@unique([institutionId, id])
  @@index([genderId])
  @@index([studentStatusId])
  @@index([townId])
