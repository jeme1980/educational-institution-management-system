# Production environment contract. Keep secrets out of this file.
NODE_ENV="production"

# API server
PORT="4000"
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# School runtime connection. Must be a LOGIN, NOSUPERUSER, NOBYPASSRLS role.
RLS_RUNTIME_DATABASE_URL="postgresql://school_app:replace-at-provisioning@host-pooler.region.example/database?sslmode=require"
RLS_RUNTIME_DB_ROLE="school_app"
RLS_RUNTIME_DB_PASSWORD="replace-at-provisioning"

# Backward-compatible runtime alias used by the API when RLS_RUNTIME_DATABASE_URL is absent.
DATABASE_URL="postgresql://school_app:replace-at-provisioning@host-pooler.region.example/database?sslmode=require"

# Migration/admin connection. Never use it for API runtime.
MIGRATION_DATABASE_URL="postgresql://migration_user:replace-at-provisioning@host.region.example/database?sslmode=require"

# Platform runtime connection. Must be a LOGIN, NOSUPERUSER, NOBYPASSRLS role.
PLATFORM_DATABASE_URL="postgresql://platform_app:replace-at-provisioning@host-pooler.region.example/database?sslmode=require"
PLATFORM_RUNTIME_DB_ROLE="platform_app"
PLATFORM_RUNTIME_DB_PASSWORD="replace-at-provisioning"

# Angular SPA static server
WEB_PORT="3000"

# Optional platform administrator for the explicit production bootstrap command.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# Web static server
WEB_PORT="3000"
WEB_API_ORIGINS="https://app.example.com"
